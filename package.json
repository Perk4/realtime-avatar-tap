{
  "name": "realtime-avatar-tap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && node --experimental-strip-types --test src/*.test.ts demo/*.test.js",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node demo/serve.mjs",
    "demo:fixture": "node demo/make-fixture.mjs",
    "demo:speech-fixture": "node demo/make-speech-fixture.mjs",
    "demo:talk": "node demo/talk-fixture.mjs",
    "demo:record": "npm run build && node demo/record-demo.mjs",
    "demo:characters": "node demo/snapshot-characters.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
